# Copy to frontend/.env — Vite only reads VITE_-prefixed vars, and only from
# a .env file inside frontend/, not the project root.

# Base URL the app calls for the backend API.
VITE_API_BASE=http://localhost:8000

# Must match the backend's API_KEY (see root .env.example) if the backend has
# one set. If backend API_KEY is empty/unset, this is ignored — safe to leave
# blank for local dev. Getting these two out of sync is what causes every
# request to fail with 401 Unauthorized.
VITE_API_KEY=
