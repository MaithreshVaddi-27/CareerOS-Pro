# Environments
# Catch EVERY .env variant, not just .env and .env.local: .env.production and
# .env.staging were not ignored and would have been committed with live
# credentials. .env.example is the one that must stay tracked.
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Docker
.docker/

# Frontend (Vite/React) — node_modules was previously being zipped/committed,
# bloating the repo by tens of thousands of files for no reason
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-error.log*
frontend/.env
frontend/.env.local

# Zip/export artifacts (macOS Archive Utility resource forks)
__MACOSX/
*.zip

# Python / General
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest / Coverage / Linters
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.ruff_cache/

# Databases & Vector Stores
*.db
*.sqlite3
careeros_dev.db
qdrant_local/

# IDEs, Editors, and OS
# Agent/tool scratch state. These ship their own nested .gitignore, so they only
# self-ignore once the tool has run at least once — list them here so a fresh
# clone or a first run before that self-ignore exists is still safe.
.remember/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Logs and Scratch
*.log
scratch/

# Granian / Production
*.pid
*.sock

# MyPy / Type Checking
.mypy_cache/
.dmypy.json
dmypy.json

# Package / Distribution
*.whl
*.tar.gz

# Jupyter
.ipynb_checkpoints/

.freebuff/
