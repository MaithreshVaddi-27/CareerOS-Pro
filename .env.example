# ==============================================================================
# CareerOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in what you need:
#     cp .env.example .env
#
# Rules that matter:
#   * Keys are EMPTY by default. An empty key means "not configured" and the
#     matching integration is skipped. Do not leave placeholder text like
#     "your_key_here" in a real key — a non-empty placeholder LOOKS
#     configured, so the app will call the provider and fail on every request
#     instead of quietly disabling itself.
#   * Every variable here must exist in backend/core/config.py. CI fails the
#     build if the two ever disagree.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# development | production
APP_ENV=development

# ------------------------------------------------------------------------------
# Database — MySQL only (no SQLite fallback at runtime)
# ------------------------------------------------------------------------------
# Option A (default): let the app build the URL from these parts.
# Use 127.0.0.1 for a local MySQL; docker-compose overrides it to "mysql".
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=careeros
MYSQL_USER=careeros
MYSQL_PASSWORD=

# Option B: a full URL, which overrides the MYSQL_* parts above.
#   local: mysql+pymysql://careeros:pass@127.0.0.1:3306/careeros
#   docker: mysql+pymysql://careeros:pass@mysql:3306/careeros
#   cloud: mysql+pymysql://user:pass@host.region.rds.amazonaws.com:3306/careeros
DATABASE_URL=

# ------------------------------------------------------------------------------
# Schema
# ------------------------------------------------------------------------------
# No migration tool. The app never creates or alters tables at startup, so the
# schema cannot drift silently — but you own applying it.
#
# After cloning, and after any change that adds a table:
#     python -c "from backend.core.db import create_all; create_all()"
#
# Always use create_all(). Calling Base.metadata.create_all(engine) directly
# exits 0 and creates NOTHING: Base has an empty metadata registry until a model
# module is imported, and create_all() does that import first.
#
# create_all() CREATES missing tables and missing indexes. It does not ALTER
# columns, drop tables, or change column types — widening an existing column
# needs a manual, reviewed ALTER per environment (docs/DEPLOYMENT.md).

# ------------------------------------------------------------------------------
# API access control
# ------------------------------------------------------------------------------
# Empty = open access, no auth. That is the intended local-dev default, not an
# oversight. Set a real value in production; clients must then send
# X-API-Key: <this_value>.
#
# If you set API_KEY here you MUST set the identical value as VITE_API_KEY in
# frontend/.env, or every frontend request fails with 401 and the cause is not
# obvious from the browser.
API_KEY=

# Requests per minute, per client IP. Excess gets 429 + Retry-After.
RATE_LIMIT_PER_MINUTE=60

# Origins the browser may call this API from. Override in production, e.g.
# ALLOWED_ORIGINS=https://app.careeros.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Rate limiting across workers — Redis (optional but recommended)
# ------------------------------------------------------------------------------
# Empty = in-process counters. Correct for ONE worker. With N workers the
# effective limit silently becomes N x RATE_LIMIT_PER_MINUTE, because each
# worker counts independently.
# Run >1 worker? Set this, then start the bundled Redis:
#     REDIS_URL=redis://redis:6379/0
#     docker compose --profile ratelimit up -d redis
#
# If Redis is unreachable the limiter fails OPEN (requests are served, an error
# is logged) rather than 500-ing everything.
REDIS_URL=

# Refuse to start instead of silently falling back to in-memory checkpoints when
# the MySQL checkpointer fails. Turn ON in production: the fallback loses
# human-review state on every restart and otherwise looks healthy from outside.
# Leave OFF for local dev, where MemorySaver is fine.
CHECKPOINT_STRICT=false

# ------------------------------------------------------------------------------
# Job discovery
# ------------------------------------------------------------------------------
# mock = fixture data, needs no keys. live = real providers.
# Start in mock, fill in real keys below, then flip this to live — otherwise a
# placeholder key makes the app call a provider with a fake credential and every
# request fails.
JOB_API_MODE=mock

# Which sources to use when live.
# No key needed: remotive, remoteok, arbeitnow, company
# Key required: jsearch, adzuna
# 'company' is the built-in career-page scraper (BeautifulSoup4, already in
# requirements.txt). It infers a company from the query and reads that
# company's own careers page as a second source.
JOB_SOURCES=jsearch,adzuna,remotive,remoteok,arbeitnow,company

# ---- JSearch (RapidAPI) — https://rapidapi.com/letscrape-6bRBa3QG1q/api/jsearch
# ~200 requests/month on the free tier.
JSEARCH_API_KEY=

# ---- Adzuna — https://developer.adzuna.com/
# ~1,000 requests/month on the free tier.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# in (India), us, gb, au, de, ...
ADZUNA_COUNTRY=in

# ------------------------------------------------------------------------------
# LLM provider routing
# ------------------------------------------------------------------------------
# auto | gemini — Gemini is the only LLM provider
# none       — no LLM; explanations come back as "unknown"
LLM_PROVIDER_MODE=auto

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Aliases auto-follow rollouts: gemini-flash-latest, gemini-pro-latest
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# Vector search (Qdrant) — NOT the source of truth; MySQL is.
# ------------------------------------------------------------------------------
# Local file mode: ./qdrant_local
# Docker/Cloud:    http://localhost:6333
QDRANT_URL=./qdrant_local

# ------------------------------------------------------------------------------
# Job verification (Firecrawl) — https://www.firecrawl.dev/
# Confirms a posting is still live before verified=true. 500 credits/month.
FIRECRAWL_API_KEY=

# ------------------------------------------------------------------------------
# Company career-page scraper
# ------------------------------------------------------------------------------
# Paths to probe under the company domain, highest priority first — teaches the
# scraper a new ATS layout without code changes, e.g. /careers/jobs (Workday),
# /search/careers (SmartRecruiters).
COMPANY_CAREER_PAGE_PATTERNS=
# Paths tried per company before giving up.
COMPANY_SCRAPER_MAX_URL_PROBES=4
# Cached scraped-HTML entries held in memory.
COMPANY_SCRAPER_CACHE_SIZE=100
# Cache lifetime in seconds; stops returning a stale job list. 0 disables expiry.
COMPANY_SCRAPER_CACHE_TTL_SECONDS=900
# Concurrent requests per domain — be polite, do not hammer one site.
COMPANY_SCRAPER_MAX_CONCURRENCY=5
# Max random jitter (seconds) on retry backoff, to avoid thundering-herd retries.
COMPANY_SCRAPER_JITTER_MAX=0.5
# Per-request HTTP timeout (seconds).
COMPANY_SCRAPER_TIMEOUT_SECONDS=20
# Retries AFTER the first attempt. Only 429/5xx and transport errors retry; a
# 404/403 fails fast because retrying cannot change the answer.
COMPANY_SCRAPER_MAX_RETRIES=2
# Identify yourself to the sites you scrape.
COMPANY_SCRAPER_USER_AGENT=CareerOS/1.0 (+https://github.com/MaithreshVaddi-27/CareerOS-Pro)

# ------------------------------------------------------------------------------
# Job retention (no env var — flags live on the command)
# ------------------------------------------------------------------------------
# Jobs whose posting disappears are marked is_active=false rather than deleted,
# so the table only grows. Prune them on a schedule:
#     python -m backend.retention --days 90
# That is a DRY RUN and reports what it would remove. To actually delete, in
# bounded batches, re-run with --yes:
#     python -m backend.retention --days 90 --yes
# Both must be run from the repo root with the backend venv active.

# ------------------------------------------------------------------------------
# Frontend — read from frontend/.env, NOT this file.
# ------------------------------------------------------------------------------
# Vite only exposes VITE_-prefixed variables, and only to browser code.
# Listed here so the whole config surface reads in one place; set it for real in
# frontend/.env. Must match API_KEY above if you set one.
VITE_API_BASE=http://localhost:8000