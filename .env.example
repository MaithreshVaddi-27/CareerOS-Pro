# ==============================================================================
# CareerOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Uncomment and set values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development  # development | production

# ------------------------------------------------------------------------------
# Database — MySQL Required (No SQLite Fallback)
# ------------------------------------------------------------------------------
# MySQL configuration is required. The app constructs DATABASE_URL from these values.
# Option A: Use MySQL components (recommended)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=careeros
MYSQL_USER=careeros
MYSQL_PASSWORD=your_secure_password_here

# Option B: Explicit DATABASE_URL (overrides MYSQL_* above)
# Must be set to a MySQL connection string. Examples:
#   MySQL (local):     mysql+pymysql://careeros:password@127.0.0.1:3306/careeros
#   MySQL (Docker):    mysql+pymysql://careeros:password@mysql:3306/careeros
#   MySQL (Cloud/AWS): mysql+pymysql://user:pass@host.region.rds.amazonaws.com:3306/careeros
DATABASE_URL=

# ------------------------------------------------------------------------------
# Database Migrations — Alembic
# ------------------------------------------------------------------------------
# Schema is owned by Alembic. The app does NOT create or alter tables at startup.
# After cloning, and after pulling any change that adds a migration, run:
#     alembic upgrade head
# "Revision file"          -> create one:
#     alembic revision --autogenerate -m "describe the change"
#     then edit it by hand and review it before committing.
# To see whether the models have drifted from the migrations:
#     alembic check          (exit 0 = in sync; this also runs in CI)
# To roll back one revision:
#     alembic downgrade -1
# WARNING: never edit a migration that has already been applied anywhere — add a
# new one instead, or environments will silently diverge.

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# Optional API key for protecting all endpoints.
# If set to a non-empty value, clients must send: X-API-Key: <this_value>
# Empty (default below) = open access, no auth required — this IS the dev default,
# not a placeholder to fill in. Required to be *present* in .env (backend won't
# start without the line at all), but empty is a valid, intended value.
# IMPORTANT: if you set this to a real value, also set VITE_API_KEY to the exact
# same value in frontend/.env — otherwise the frontend gets 401 Unauthorized on
# every single request, because it has no way to know a key is now required.
API_KEY=

# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=60

# Shared rate-limit counter store (Redis). Leave EMPTY to use in-process
# counters — correct for a single worker, but with N workers the effective limit
# is N x RATE_LIMIT_PER_MINUTE because each worker counts independently.
# Set this before running multiple workers:
#   local/docker:  REDIS_URL=redis://redis:6379/0
# Then start the bundled Redis with:
#   docker compose --profile ratelimit up -d redis
# If Redis is unreachable the limiter fails OPEN (serves requests) and logs an
# error, rather than 500-ing every request.
REDIS_URL=

# Refuse to start instead of silently falling back to in-memory checkpoints when
# MySQL checkpointing fails. Turn ON in production: the fallback loses
# human-review state on every restart and previously looked healthy from outside.
# Leave OFF for local dev, where MemorySaver is fine.
CHECKPOINT_STRICT=false

# Comma-separated list of origins the browser is allowed to call this API
# from. Defaults cover local dev (Vite on 5173, CRA-style on 3000) — override
# with your real frontend origin(s) in production, e.g.
# ALLOWED_ORIGINS=https://app.careeros.example
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Job Discovery APIs — At least one required for JOB_API_MODE=live
# ------------------------------------------------------------------------------
# Mode: mock (no keys, returns fixture data) | live (real APIs)
JOB_API_MODE=live

# Comma-separated list of sources to enable.
# Free (no key): remotive, remoteok, arbeitnow, company
# Paid (needs key): jsearch, adzuna
# 'company' = the built-in company-career-page scraper agent
# (backend/services/company_scraper.py, BeautifulSoup4 — already open source,
# already in requirements.txt, no extra tool/key needed). It infers a company
# name from the search query and scrapes that company's own careers page as a
# secondary source; results dedup the same way as the API sources.
JOB_SOURCES=jsearch,adzuna,remotive,remoteok,arbeitnow,company

# ---- JSearch (RapidAPI) ----
# Get key: https://rapidapi.com/letscrape-6bRBa3QG1q/api/jsearch
# Free tier: ~200 requests/month
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here

# ---- Adzuna ----
# Register: https://developer.adzuna.com/
# Free tier: ~1,000 requests/month
# Country codes: in (India), us (USA), gb (UK), au (Australia), de (Germany), etc.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in

# ------------------------------------------------------------------------------
# AI / LLM Configuration
# ------------------------------------------------------------------------------
# LLM Provider routing:
#   auto       — Try local llama.cpp → NVIDIA NIM → OpenRouter → Gemini (in order)
#   llama      — Use local llama.cpp only
#   gemini     — Use Google Gemini only
#   openrouter — Use OpenRouter (unified API for 100+ models)
#   nvidia     — Use NVIDIA NIM (optimized inference)
#   none       — No LLM (returns "unknown" for explanations)
LLM_PROVIDER_MODE=auto

# ---- Local LLM (llama.cpp) ----
# Run a local server: llama-server -m model.gguf --port 8080
# Or use Docker: docker run -p 8080:8080 ghcr.io/ggerganov/llama.cpp:server -m model.gguf
LLAMA_CPP_BASE_URL=http://localhost:8080

# ---- Google Gemini ----
# Get key: https://aistudio.google.com/app/apikey
# Model alias (auto-follows rollouts): gemini-flash-latest, gemini-pro-latest
# Free tier available
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ---- OpenRouter ----
# Get key: https://openrouter.ai/keys
# Free tier: generous daily credits
# Free models: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free,
#              mistralai/mistral-7b-instruct:free, microsoft/phi-3-mini-128k-instruct:free
# Popular paid models: anthropic/claude-3.5-sonnet, openai/gpt-4o, meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Code default is anthropic/claude-3.5-sonnet (paid) — swap to a free model above if you don't want billing
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- NVIDIA NIM ----
# Get key: https://build.nvidia.com/explore/discover
# Free tier: generous credits for testing
# Free models: meta/llama-3.1-8b-instruct, google/gemma-2-9b-it
# Popular models: meta/llama-3.1-70b-instruct, nvidia/nemotron-3-ultra
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# Vector Search (Qdrant)
# ------------------------------------------------------------------------------
# Local file mode (dev): ./qdrant_local
# Production (Docker/Cloud): http://localhost:6333 or https://your-cluster.qdrant.io
QDRANT_URL=./qdrant_local

# ------------------------------------------------------------------------------
# Job Verification (Firecrawl)
# ------------------------------------------------------------------------------
# Get key: https://www.firecrawl.dev/
# Free tier: 500 credits/month
# Used to confirm job postings are still live before marking verified=true
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# Company Career-Page Scraper
# ------------------------------------------------------------------------------
# Career-page paths to probe under the company domain, highest priority first.
# Use this to teach the scraper a new ATS layout without touching code.
# e.g. /careers/jobs for Workday, /search/careers for SmartRecruiters
COMPANY_CAREER_PAGE_PATTERNS=
# How many of those paths are probed per company before giving up.
COMPANY_SCRAPER_MAX_URL_PROBES=4
# Max cached scraped-HTML entries kept in memory.
COMPANY_SCRAPER_CACHE_SIZE=100
# Cache entry lifetime in seconds. Stops returning a stale job list.
# Set to 0 to disable expiry.
COMPANY_SCRAPER_CACHE_TTL_SECONDS=900
# Max concurrent scraper requests per domain (be polite — don't hammer one site).
COMPANY_SCRAPER_MAX_CONCURRENCY=5
# Max random jitter (seconds) added to retry backoff, to avoid thundering-herd retries.
COMPANY_SCRAPER_JITTER_MAX=0.5
# Per-request HTTP timeout (seconds).
COMPANY_SCRAPER_TIMEOUT_SECONDS=20
# Retries AFTER the first attempt. Only 429/5xx and transport errors retry;
# a 404 or 403 fails fast because retrying will not change the answer.
COMPANY_SCRAPER_MAX_RETRIES=2
# User-Agent sent to career pages. Identify yourself and a contact URL.
COMPANY_SCRAPER_USER_AGENT=CareerOS/1.0 (+https://github.com/MaithreshVaddi-27/CareerOS-Pro)

# ------------------------------------------------------------------------------
# Frontend (frontend/.env — Vite only reads VITE_-prefixed vars, and only from
# frontend/.env, not this file. Listed here so the full config surface is in
# one place.)
# ------------------------------------------------------------------------------
# Base URL the React app calls for the backend API.
VITE_API_BASE=http://localhost:8000
