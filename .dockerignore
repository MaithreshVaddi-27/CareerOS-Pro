# Keep the build context small and the image free of host state.
#
# The venv matters most: it sits at backend/venv, inside the `COPY backend/`
# line in the Dockerfile, so without this line a 585 MB local environment —
# 8454 .py files, macOS-built wheels — gets baked into every image. Those
# wheels are wrong for the image's platform anyway.

# Secrets. Mounted at runtime via compose `env_file`, never copied in.
.env
.env.*
!.env.example

# Local Python environments (see above)
backend/venv/
**/venv/
**/.venv/
**/site-packages/

# Bytecode and tooling caches
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# VCS and tooling
.git/
.gitignore
.github/
.venv/

# Node — the backend image never needs it
node_modules/
frontend/node_modules/
frontend/dist/

# Tests and docs are not runtime inputs
tests/
docs/
AUDIT.md
*.md

# Editor and OS noise
.vscode/
.idea/
.DS_Store